# TailHedge — Environment Configuration
# Copy this file to .env and adjust values. Never commit .env with real secrets.

# --- Operation mode ---
# One of: RESEARCH_ONLY, SHADOW, PAPER, LIVE_APPROVAL, LIVE_AUTONOMOUS
# Live modes require allow_live=True and are not supported in MVP.
TAILHEDGE_MODE=RESEARCH_ONLY
TAILHEDGE_ALLOW_LIVE=false

# --- Database (non-secret parts) ---
TAILHEDGE_DATABASE_HOST=localhost
TAILHEDGE_DATABASE_PORT=5432
TAILHEDGE_DATABASE_NAME=tailhedge
TAILHEDGE_DATABASE_USER=tailhedge

# --- Secrets (loaded from env only, never committed) ---
# TAILHEDGE_SECRET_DATABASE_URL=postgresql+psycopg://tailhedge:PASSWORD@localhost:5432/tailhedge
# TAILHEDGE_SECRET_IBKR_PASSWORD=
# TAILHEDGE_SECRET_IBKR_ACCOUNT=
# TAILHEDGE_SECRET_AGENT_API_KEY=
# TAILHEDGE_SECRET_NOTIFICATION_API_KEY=
# TAILHEDGE_SECRET_SESSION_SECRET=

# --- Dataset ---
TAILHEDGE_DATASET_ROOT=data

# --- Scheduling ---
TAILHEDGE_DECISION_TIME=15:45
TAILHEDGE_DECISION_TIMEZONE=America/New_York

# --- Broker (non-secret) ---
TAILHEDGE_BROKER_HOST=127.0.0.1
TAILHEDGE_BROKER_PORT=7497
TAILHEDGE_BROKER_CLIENT_ID=1
TAILHEDGE_BROKER_ACCOUNT_ALIAS=paper

# --- Agent / sandbox ---
# TAILHEDGE_AGENT_PROVIDER_COMMAND=
TAILHEDGE_SANDBOX_CPU_SECONDS=30
TAILHEDGE_SANDBOX_MEMORY_MB=512
TAILHEDGE_SANDBOX_PID_MAX=64

# --- Risk thresholds ---
TAILHEDGE_MAX_ANNUAL_PREMIUM_PCT=0.03
TAILHEDGE_MAX_SINGLE_PREMIUM_PCT=0.01

# --- Session ---
TAILHEDGE_SESSION_COOKIE_SECURE=false
TAILHEDGE_SESSION_COOKIE_SAMESITE=strict
TAILHEDGE_SESSION_MAX_AGE_SECONDS=86400
